{
  "openapi": "3.1.0",
  "info": {
    "title": "VulnScope Evidence-Grounded Security Agent",
    "description": "通过受控 Spring Boot 统计接口读取真实数据的离线解释 Agent。",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/agent/capabilities": {
      "get": {
        "summary": "Capabilities",
        "operationId": "capabilities_api_v1_agent_capabilities_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Capabilities Api V1 Agent Capabilities Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/agent/ask": {
      "post": {
        "summary": "Ask",
        "operationId": "ask_api_v1_agent_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentAnswer"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentAnswer": {
        "properties": {
          "mode": {
            "type": "string",
            "title": "Mode"
          },
          "model_used": {
            "type": "boolean",
            "title": "Model Used"
          },
          "model_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Name"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "tool_name": {
            "type": "string",
            "title": "Tool Name"
          },
          "source_endpoint": {
            "type": "string",
            "title": "Source Endpoint"
          },
          "queried_at": {
            "type": "string",
            "title": "Queried At"
          },
          "evidence": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Evidence"
          },
          "notice": {
            "type": "string",
            "title": "Notice"
          }
        },
        "type": "object",
        "required": [
          "mode",
          "model_used",
          "answer",
          "tool_name",
          "source_endpoint",
          "queried_at",
          "evidence",
          "notice"
        ],
        "title": "AgentAnswer"
      },
      "AskRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Question",
            "description": "关于系统总体风险或六维统计的问题"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AskRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
