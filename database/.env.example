VULNSCOPE_DB_HOST=127.0.0.1
VULNSCOPE_DB_PORT=3306
VULNSCOPE_DB_NAME=vulnscope
VULNSCOPE_DB_USER=vulnscope
VULNSCOPE_DB_PASSWORD=set-a-local-password
VULNSCOPE_JWT_SECRET=set-a-random-secret-at-least-32-characters
VULNSCOPE_ADMIN_PASSWORD=set-a-local-admin-password

# Remote Spark submission is disabled by default.
VULNSCOPE_SPARK_SUBMIT_ENABLED=false
VULNSCOPE_SSH_HOST=127.0.0.1
VULNSCOPE_SSH_PORT=22
VULNSCOPE_SSH_USERNAME=spark
VULNSCOPE_SSH_PASSWORD=
VULNSCOPE_SPARK_LOCAL_JAR=../spark-job/target/vulnscope-spark-job.jar
VULNSCOPE_SPARK_REMOTE_JAR=/opt/vulnscope/vulnscope-spark-job.jar
VULNSCOPE_SPARK_INPUT=hdfs:///vulnscope/input/vulnerabilities.jsonl
VULNSCOPE_SPARK_OUTPUT_ROOT=hdfs:///vulnscope/output-ui
